# Copy to .env and fill in. Every HA_* entity is optional – leave it empty
# and that card simply shows "nicht konfiguriert".

# ---- Server ----
PORT=8080
# Fallback poll of Home Assistant (seconds). Changes normally arrive
# instantly via the HA WebSocket API; this only catches anything missed.
POLL_INTERVAL=60
# How often server stats (CPU/RAM/Disk) are refreshed (seconds)
SERVER_POLL_INTERVAL=5

# ---- Home Assistant ----
# Profile -> Security -> Long-lived access tokens -> Create token
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# person.*, device_tracker.* or a binary_sensor (motion/occupancy/mmWave)
HA_PRESENCE_ENTITY=person.diego
# Illuminance sensor (lx) or a binary "light detected" sensor
HA_LUX_ENTITY=sensor.room_illuminance
# Lux value from which the room counts as "hell"
HA_LUX_THRESHOLD=50
# Comma separated list of lights you want to see/control
HA_LIGHT_ENTITIES=light.desk,light.ceiling
HA_WEATHER_ENTITY=weather.forecast_home
# Companion app sensors (Settings -> Companion app -> Manage sensors)
HA_STEPS_ENTITY=sensor.pixel_daily_steps
HA_HEART_RATE_ENTITY=sensor.pixel_heart_rate
HA_BATTERY_ENTITY=sensor.pixel_battery_level
# HA to-do lists shown in the dashboard (switchable), e.g. Todoist projects
HA_TODO_ENTITIES=todo.inbox,todo.dashboard,todo.shopping_list

# ---- "At a glance" next to the clock (all optional) ----
# Timestamp sensor of your next alarm (e.g. Alexa Media Player)
HA_ALARM_ENTITY=sensor.echo_dot_next_alarm
# Companion-app prefix: uses <prefix>_sleep_duration, _deep_sleep, _rem_sleep, _core_sleep, _awake
HA_SLEEP_PREFIX=sensor.my_iphone
# Router: internet status + current speed (KiB/s)
HA_WAN_ENTITY=binary_sensor.router_wan_status
HA_DOWNLOAD_ENTITY=sensor.router_download_speed
HA_UPLOAD_ENTITY=sensor.router_upload_speed
# Media players with play/pause/next controls
HA_MEDIA_ENTITIES=media_player.echo_dot
