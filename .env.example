# Copy to .env and fill in. Every HA_* entity is optional – leave it empty
# and that card simply shows "nicht konfiguriert".

# ---- Server ----
PORT=8080
# Fallback poll of Home Assistant (seconds). Changes normally arrive
# instantly via the HA WebSocket API; this only catches anything missed.
POLL_INTERVAL=60
# How often server stats (CPU/RAM/Disk) are refreshed (seconds)
SERVER_POLL_INTERVAL=5

# Listen address. 127.0.0.1 = only reachable through the Cloudflare Tunnel /
# a reverse proxy on this machine (recommended once the domain is set up).
BIND_ADDRESS=0.0.0.0

# ---- Cloudflare Tunnel (optional, see README) ----
# Token of your tunnel (Zero Trust -> Networks -> Tunnels -> your tunnel).
# Start with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# ---- Accounts ----
# Users are managed in the dashboard (account menu -> "Benutzer verwalten").
# Create the first admin once:
#   docker compose exec -it dashboard dashboard_backend --create-admin <name>
# Set to 1 when the dashboard is served over HTTPS (tunnel / reverse proxy):
COOKIE_SECURE=0
# Set to 1 behind the tunnel / a reverse proxy so the login lock sees real
# visitor IPs. Only together with BIND_ADDRESS=127.0.0.1!
TRUST_PROXY=0
# How long a login stays valid (days)
SESSION_DAYS=30

# ---- Home Assistant ----
# Profile -> Security -> Long-lived access tokens -> Create token
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# person.*, device_tracker.* or a binary_sensor (motion/occupancy/mmWave)
HA_PRESENCE_ENTITY=person.diego
# Illuminance sensor (lx) or a binary "light detected" sensor
HA_LUX_ENTITY=sensor.room_illuminance
# Lux value from which the room counts as "hell"
HA_LUX_THRESHOLD=50
# Comma separated list of lights you want to see/control
HA_LIGHT_ENTITIES=light.desk,light.ceiling
HA_WEATHER_ENTITY=weather.forecast_home
# Companion app sensors (Settings -> Companion app -> Manage sensors)
HA_STEPS_ENTITY=sensor.pixel_daily_steps
HA_HEART_RATE_ENTITY=sensor.pixel_heart_rate
HA_BATTERY_ENTITY=sensor.pixel_battery_level
# HA to-do lists shown in the dashboard (switchable), e.g. Todoist projects
HA_TODO_ENTITIES=todo.inbox,todo.dashboard,todo.shopping_list

# ---- "At a glance" next to the clock (all optional) ----
# Timestamp sensor of your next alarm (e.g. Alexa Media Player)
HA_ALARM_ENTITY=sensor.echo_dot_next_alarm
# Companion-app prefix: uses <prefix>_sleep_duration, _deep_sleep, _rem_sleep, _core_sleep, _awake
HA_SLEEP_PREFIX=sensor.my_iphone
# Router: internet status + current speed (KiB/s)
HA_WAN_ENTITY=binary_sensor.router_wan_status
HA_DOWNLOAD_ENTITY=sensor.router_download_speed
HA_UPLOAD_ENTITY=sensor.router_upload_speed
# Media players with play/pause/next controls
HA_MEDIA_ENTITIES=media_player.echo_dot

# ---- Voice: Alexa commands + morning briefing (optional) ----
# Needs the Alexa Media Player integration. Enable on ONE instance only
# (the server), otherwise every answer is spoken twice.
# Echo that hears the commands (its last_called_summary is read):
HA_ALEXA_ENTITY=media_player.echo_dot
# Notify service of that Echo (without "notify."):
HA_ALEXA_NOTIFY=alexa_media_echo_dot
# Amazon Polly voice for answers (German: Hans, Marlene, Vicki):
VOICE_NAME=Hans
# Name used in greetings ("Guten Morgen Diego"):
VOICE_USER=
# Morning briefing N minutes after the Echo alarm, if someone is in the room (-1 = off):
BRIEFING_DELAY_MIN=2
# Wake-up light: fade all lights in over N minutes before the alarm (0 = off):
WAKE_LIGHT_MIN=0

# --- iPhone app (HomeCollect) ---
# Whose uploaded data the health card shows (empty = newest upload).
COLLECT_DASHBOARD_USER=
# Publish summaries to Home Assistant as sensor.homecollect_<user>_* and
# device_tracker.homecollect_<user> (0 = off).
HA_COLLECT_PUBLISH=1

# --- Backups (collect.db as .gz, users.json, prefs.json) ---
# Target folder (empty = DATA_DIR/backups). Copy it off the server (NAS, 2nd disk)!
BACKUP_DIR=
# Number of daily backups to keep:
BACKUP_KEEP=7
# Local hour of the daily backup (0-23):
BACKUP_HOUR=3

# --- Automations & push notifications (HA companion app) ---
# notify service of your phone, without "notify." (empty = no pushes at all):
HA_NOTIFY_TARGET=mobile_app_your_iphone
# Whose settings / iPhone data drive the home automations (empty = first admin):
OWNER_USER=
# iPhone focus sensor (companion app): Sleep focus ends -> morning briefing push.
# Empty = fallback: room presence after the Echo alarm / after 05:30.
HA_FOCUS_ENTITY=binary_sensor.your_iphone_focus

# --- Arrive/leave extras (each can be switched off in the app) ---
# Calendar with homework + tests as events on the due day (e.g. from Notion).
# The evening before a school day you get a push; tests in the next week too.
HA_HOMEWORK_CALENDAR=calendar.notion
# School days: mon,tue,wed,thu,fri,sat,sun (default mon-fri)
SCHOOL_DAYS=mon,tue
# To-do list pushed when you leave work
HA_SHOPPING_LIST=todo.shopping_list

# --- Claude tab in the iPhone app (admins only, optional) ---
# A small bridge on the host runs Claude Code for the app (see README "Claude-Tab"):
#   scripts/claude-bridge.py, systemd unit deploy/claude-bridge.service
# Empty = tab shows "not set up". Token: openssl rand -hex 32
CLAUDE_BRIDGE_URL=http://127.0.0.1:8091
CLAUDE_BRIDGE_TOKEN=
# Folder Claude works in:
CLAUDE_WORKDIR=/srv/projekte
# What Claude may do without asking (nobody can answer a prompt from the phone):
#   acceptEdits       = read + edit files; shell commands only from CLAUDE_ALLOWED_TOOLS
#   bypassPermissions = everything, incl. any shell command as root - only if you really want that
CLAUDE_PERMISSION_MODE=acceptEdits
# Extra allowed tools, comma separated, e.g. Bash(git status:*),Bash(git diff:*),Bash(docker compose logs:*)
CLAUDE_ALLOWED_TOOLS=
# Optional model alias, empty = Claude Code default
CLAUDE_MODEL=
